APP_NAME=SolveX API
DEBUG=true

# PostgreSQL (default, started with: docker compose up -d)
DATABASE_URL=postgresql+psycopg://solvex:change-me@localhost:5432/solvex
POSTGRES_PASSWORD=change-me

# SQLite alternative:
# DATABASE_URL=sqlite:///./solvex.db

# Comma-separated list, or JSON: ["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Auth - generate a strong value for production, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
# Short-lived access token; the mobile app refreshes it silently.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived, rotating refresh token (stored hashed and revocable).
REFRESH_TOKEN_EXPIRE_DAYS=30

# Background scheduler for reminders/escalations (set false in tests).
ENABLE_SCHEDULER=true

# Expo Push. In-app notifications are always stored even when push is off.
PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
PUSH_TIMEOUT_SECONDS=5
