# Optional: override the auto-detected backend address.
# Auto-detection uses the Expo dev-server host, which usually works on a
# physical phone connected to the same Wi-Fi as the backend machine.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1

# Required only for remote push notifications. Create an Expo project and put
# its project ID here. Local measurement reminders work without it.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
